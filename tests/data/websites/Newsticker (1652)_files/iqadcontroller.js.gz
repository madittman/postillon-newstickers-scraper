adc_local_style:"#iqd_mainAd {\r\n    height: auto;\r\n    padding: 0;\r\n    padding-top: 20px;\r\n    margin-bottom: 10px;\r\n    clear: both;\r\n}\r\n\r\n#iqd_align_Ad {\r\n    margin: 0 auto;\r\n    position: relative;\r\n    width: 1070px;\r\n}\r\n\r\n#iqd_topAd {\r\n    padding: 0;\r\n    position: relative;\r\n    display: flex !important;\r\n    flex-direction: column;\r\n    justify-content: center;\r\n}\r\n\r\n#iqd_rightAd,\r\n#iqd_leftAd {\r\n    position: fixed;\r\n}\r\n\r\n#iqd_rightAd:has(#iqadtile21_placeholder_iq) {\r\n    display: flex !important;\r\n}\r\n\r\n#iqd_leftAd:has(#iqadtile20_placeholder_iq) {\r\n    display: flex !important;\r\n}\r\n\r\n[id^='iqadtile'] {\r\n    position: relative;\r\n    display: table;\r\n    font-size: 0;\r\n    text-align: center;\r\n    margin-right: auto;\r\n    margin-left: auto;\r\n}\r\n\r\n#iqadtile21,\r\n#iqadtile20 {\r\n    margin-left: 0;\r\n    margin-right: 0;\r\n    min-width: 160px;\r\n}\r\n\r\n#iqadtile21 {\r\n    text-align: left;\r\n}\r\n\r\n#iqadtile20 {\r\n    text-align: right;\r\n}\r\n\r\n#iqadtile4 {\r\n    overflow: visible !important;\r\n    padding-top: 20px;\r\n}\r\n\r\n.iqlabel-iefix {\r\n    line-height: 16px !important;\r\n}\r\n\r\n.iqlabel::before {\r\n    position: relative;\r\n    display: block;\r\n    width: 100%;\r\n    color: #000;\r\n    font-size: 12px;\r\n    font-weight: normal;\r\n    font-family: 'Source Sans Pro', Arial, sans-serif;\r\n    letter-spacing: 1px;\r\n    text-transform: uppercase;\r\n    white-space: nowrap;\r\n    height: 21px;\r\n    line-height: 21px;\r\n}\r\n\r\n.iqlabel-centered::before {\r\n    text-align: center;\r\n}\r\n\r\n.iqlabel-left::before {\r\n    text-align: center;\r\n}\r\n\r\n.iqlabel-stdtxt::before {\r\n    content: 'REKLAME';\r\n}\r\n\r\n.iqlabel-customtxt::before {\r\n    content: 'REKLAME';\r\n}\r\n\r\n.iqadtile-space-tb {\r\n    margin-top: 20px;\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.iqadtile-wrapper {\r\n    clear: both;\r\n}\r\n\r\n#iqadtile3 {\r\n    margin-top: 10px;\r\n}\r\n\r\n#iqadtile16 {\r\n    min-width: 1000px;\r\n}\r\n\r\n#iqadtile4,\r\n#iqadtile5,\r\n#iqadtile51,\r\n#iqadtile52,\r\n#iqadtile53,\r\n#iqadtile8,\r\n#iqadtile81,\r\n#iqadtile82,\r\n#iqadtile9 {\r\n    min-width: 300px;\r\n}\r\n\r\n[data-iqdselector='homepage'] div#iqadtile4-backdrop,\r\n[data-iqdselector='homepage'] iframe#iqadtile4-frame,\r\n[data-iqdselector='index'] div#iqadtile4-backdrop,\r\n[data-iqdselector='index'] iframe#iqadtile4-frame {\r\n    top: 40px !important;\r\n}\r\n\r\n[data-iqdselector='artikel'] div#iqadtile4-backdrop,\r\n[data-iqdselector='artikel'] iframe#iqadtile4-frame {\r\n    top: 20px !important;\r\n}\r\n\r\n[id^='iqadtile'] > div[id^='google_ads_iframe'] {\r\n    margin: 0 auto;\r\n}\r\n\r\n/* fix background-color in artikel */\r\n\r\n/* postillion colorscheme */\r\n\r\n/* light mode */\r\nbody[data-iqdselector='artikel'] div#content-wrapper,\r\nbody[data-iqdselector='artikel'] div#footer-ads-wrap {\r\n    background-color: #fff;\r\n}\r\n\r\n/* dark mode */\r\nhtml[class*='is-dark'] body[data-iqdselector='artikel'] div#content-wrapper,\r\nhtml[class*='is-dark'] body[data-iqdselector='artikel'] div#footer-ads-wrap {\r\n    background-color: #222226;\r\n}\r\n\r\n/* system colorscheme */\r\n\r\n/*\r\n@media (prefers-color-scheme: light) {\r\n    [data-iqdselector=\"artikel\"] div#content-wrapper,\r\n    [data-iqdselector=\"artikel\"] div#footer-ads-wrap {\r\n    background-color: #ffffff;\r\n    }\r\n}\r\n@media (prefers-color-scheme: dark) {\r\n    [data-iqdselector=\"artikel\"] div#content-wrapper,\r\n    [data-iqdselector=\"artikel\"] div#footer-ads-wrap {\r\n    background-color: #39393a;\r\n    }\r\n} */\r\n\r\n/* Footer Ad */\r\n[id^='iqadtile6'] {\r\n    min-width: 1000px;\r\n}\r\n\r\n#iqadtile6 {\r\n    margin-top: 0 !important;\r\n    margin-bottom: 0 !important;\r\n}\r\n\r\n#iqadtile6.iqlabel::before {\r\n    line-height: 30px;\r\n}\r\n\r\n#iqd-floating-wrapper {\r\n    position: fixed;\r\n    z-index: 10000;\r\n    width: 1070px;\r\n    height: 120px;\r\n    text-align: center;\r\n    background-color: #ffffffc7;\r\n    bottom: 0;\r\n    display: none;\r\n    transition: all 0.5s ease 0s;\r\n}\r\n\r\n#iqd-close-button {\r\n    position: absolute;\r\n    top: 2px;\r\n    right: 2px;\r\n    display: block;\r\n    width: 25px;\r\n    height: 25px;\r\n    font-size: 0;\r\n    border-radius: 4px;\r\n    border: 2px solid #868686;\r\n}\r\n\r\n#iqd-close-button::before,\r\n#iqd-close-button::after {\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    width: 2px;\r\n    height: 17px;\r\n    background-color: #868686;\r\n    transform: rotate(45deg) translate(-50%, -50%);\r\n    transform-origin: top left;\r\n    content: '';\r\n}\r\n\r\n#iqd-close-button::after {\r\n    transform: rotate(-45deg) translate(-50%, -50%);\r\n}"},
